# coverletterai env. Copy to .env and fill in.

# The long-lived Anthropic Max-subscription OAuth token, generated on
# the host via ``claude setup-token`` once. Both the `claude` CLI
# subprocess (text-mode tailoring) and the Anthropic Python SDK (vision
# verifier) read this. Keep it private.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-REPLACE-WITH-YOUR-TOKEN
